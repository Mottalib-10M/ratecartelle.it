---
/**
 * Accueil d'une langue (page pilier, RECETTE §5) : la question d'abord, « quanto pago a ogni rata e quando ? »,
 * donc le calendrier personnel des rate en tête ; puis le bloc citable replié, les dates à retenir, les quatre
 * rubriques et le texte. Texte dans src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PianoTool from './da/PianoTool';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, type Locale } from '../i18n/routes';
import { navCategories } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { BUILD_TODAY } from '../lib/today';
import { AUTHOR_NAME } from '../data/site-config';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['l199', 'faqQuinquies', 'dl38', 'l113', 'elencoEnti', 'l197', 'dl202', 'dpr602', 'aderScadenze'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const it = lang === 'it';
const date = (iso: string) => H.date(iso);
const segna = [
  { d: '2026-11-30', t: it ? 'Terza rata della quinquies' : 'Third quinquies instalment', id: 'rottamazione-quinquies-30-novembre' },
  { d: P.enti.domanda_entro, t: it ? 'Ultimo giorno per la domanda di comuni e regioni' : 'Last day to apply for comuni and regions', id: 'rottamazione-quinquies-comuni-regioni' },
  { d: '2027-01-31', t: it ? 'Quarta rata della quinquies' : 'Fourth quinquies instalment', id: 'rottamazione-quinquies-scadenze' },
  { d: '2026-11-30', t: it ? 'Rata della quater e della riammissione' : 'Quater and readmission instalment', id: 'rottamazione-quater' },
];
const cats = navCategories(lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 style="hyphens: manual" class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 max-sm:text-[0.95rem] sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil><PianoTool client:load lang={lang} id="home" today={BUILD_TODAY} methodHref={route('method', lang)} /></div>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-4" />
  <p class="mt-3 text-sm text-navy-600">{it ? 'Di' : 'By'} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{it ? 'Metodo e fonti' : 'Method and sources'}</a> · <a href={route('rottamazione-quinquies-decadenza', lang)} class="underline">{it ? 'Sono decaduto?' : 'Have I lapsed?'}</a></p>
  <section data-chrome class="mt-8 rounded-xl border border-navy-200 bg-navy-50 p-4 sm:p-6" aria-labelledby="segna">
    <h2 id="segna" class="text-lg font-bold text-navy-900">{it ? 'Le prossime date da segnare' : 'The next dates to note'}</h2>
    <ol class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {segna.map((s) => (
        <li class="rounded-lg bg-white p-3 shadow-sm">
          <p class="tabular-nums text-xl font-bold text-accent-700"><time datetime={s.d}>{date(s.d)}</time></p>
          <p class="mt-1 text-sm text-navy-700"><a href={route(s.id, lang)} class="hover:underline">{s.t}</a></p>
        </li>
      ))}
    </ol>
  </section>
  <nav data-chrome aria-label={it ? 'Argomenti' : 'Topics'} class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {cats.map((c) => (
      <div class="border-t-2 border-accent-500 pt-3">
        <p class="font-semibold text-navy-900">{c.label}</p>
        <ul class="mt-1 space-y-1 text-sm">{c.links.slice(0, 5).map((k) => <li><a href={k.href} class="text-accent-700 hover:underline">{k.label}</a></li>)}</ul>
      </div>
    ))}
  </nav>
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div class="mini-bloc"><MiniSim client:load kind={p} lang={lang} href={route('rottamazione-quinquies-rate', lang)} /></div>)}
  </div>
</PageLayout>
